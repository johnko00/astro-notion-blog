---
import { Post } from '../lib/interfaces.ts'
import { filePath } from '../lib/blog-helpers'

export interface Props {
  post: Post
  fallbackImage?: string
}

const { post, fallbackImage = '' } = Astro.props

let image = ''
if (post.RepresentativeImage?.Url) {
  if (post.RepresentativeImage.Type === 'external') {
    image = post.RepresentativeImage.Url
  } else {
    try {
      image = filePath(new URL(post.RepresentativeImage.Url))
    } catch {
      image = ''
    }
  }
} else if (fallbackImage) {
  image = fallbackImage
}
---

{
  image && (
    <div class="post-featured-image">
      <img src={image} alt="Featured image of the post" />
    </div>
  )
}

<style>
  .post-featured-image {
    width: 100%;
    aspect-ratio: 1.8 / 1;
    overflow: hidden;
    background: var(--surface-muted);
  }
  .post-featured-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
