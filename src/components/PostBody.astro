---
import { Block } from '../lib/interfaces.ts'
import NotionBlocks from './NotionBlocks.astro'

export interface Props {
  blocks: Block[]
}

const { blocks } = Astro.props
---

<div class="post-body">
  <NotionBlocks blocks={blocks} isRoot={true} />
</div>

<style>
  .post-body {
    max-width: 760px;
    margin: 0 auto;
    padding: 0.9rem 0 0.5rem;
  }

  .post-body :global(img),
  .post-body :global(video),
  .post-body :global(iframe) {
    max-width: 100%;
  }

  .post-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .post-body {
      padding-top: 0.65rem;
    }
  }
</style>
