---
import type { SelectProperty } from '../lib/interfaces.ts'
import { getCategoryLink } from '../lib/blog-helpers.ts'
import NoContents from './NoContents.astro'
import '../styles/notion-color.css'

export interface Props {
  heading: string
  categories: SelectProperty[]
}

const { heading, categories } = Astro.props
---

<div class="blog-categories-link">
  <h2>{heading}</h2>
  {
    categories.length === 0 ? (
      <NoContents contents={categories} />
    ) : (
      <ul>
        {categories.map((category: SelectProperty) => (
          <li>
            <a
              href={getCategoryLink(category.name)}
              class={`tag ${category.color}`}
            >
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .blog-categories-link h2 {
    margin: 0;
    padding-left: 0.4rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .blog-categories-link ul {
    list-style-type: none;
    padding: 0;
    margin-top: 0.3rem;
    margin-block-end: 1rem;
  }
  .blog-categories-link ul li {
    position: relative;
    padding: 0.4rem;
    line-height: 1.2rem;
    font-size: 0.9rem;
    gap: 6px;
  }
  .blog-categories-link ul li a {
    min-width: 0;
    border-radius: 3px;
    padding: 2px 6px;
    line-height: 1.2;
    color: rgb(50, 48, 44);
    background: var(--category-bg);
  }
</style>
