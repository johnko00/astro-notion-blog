---
import { getPageLink } from '../lib/blog-helpers.ts'

export interface Props {
  currentPage: number
  numberOfPages: number
  category: string
}

const { currentPage, numberOfPages, category = '' } = Astro.props

const isFirstPage = currentPage === 1
const isLastPage = currentPage === numberOfPages

const startPage = currentPage - 2 < 1 ? 1 : currentPage - 2
const endPage =
  currentPage + 2 > numberOfPages ? numberOfPages : currentPage + 2

let pages = []
for (let i = startPage; i <= endPage; i++) {
  pages.push(i)
}
---

<div class="pagination">
  <a href={getPageLink(1, category)} class={isFirstPage && 'inactive'}>&lt;&lt;</a>
  {
    pages.map((p: number) => (
      <a href={getPageLink(p, category)} class={p === currentPage && 'inactive'}>
        {p}
      </a>
    ))
  }
  <a href={getPageLink(numberOfPages, category)} class={isLastPage && 'inactive'}
    >&gt;&gt;</a
  >
</div>

<style>
  .pagination {
    display: flex;
    width: 100%;
    margin: 0 auto;
    color: var(--fg);
    justify-content: center;
    align-items: center;
  }
  .pagination a {
    display: block;
    width: 2rem;
    height: 2.25rem;
    margin: 0 0.2rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: inherit;
    font-size: 0.78rem;
    text-align: center;
    text-decoration: none;
    font-weight: 500;
    line-height: 2.25rem;
  }
  .pagination a:hover:not(.inactive) {
    border-color: var(--border-strong);
    background: var(--surface-warm);
  }
  .pagination a.inactive {
    color: #999;
    background: var(--surface-muted);
  }
</style>
