---
import { Icon } from 'astro-icon/components';

export interface Props {
  iconOnly?: boolean
}

const { iconOnly = false } = Astro.props
---

<button
  class:list={['search-button', 'open-search-modal', { 'icon-only': iconOnly }]}
  type="button"
  aria-label="検索"
  title="検索"
>
  <Icon name="octicon:search-24" />
  {!iconOnly && <span>Search</span>}
</button>

<style>
  .search-button {
    display: flex;
    width: fit-content;
    align-items: center;
    background-color: transparent;
    border: none;
    border-radius: 999px;
    padding: 0.4rem 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: bold;
  }
  .search-button:hover {
    cursor: pointer;
    background-color: var(--surface-muted);
    color: var(--fg);
  }
  .search-button svg {
    width: 20px;
    height: 20px;
  }

  .search-button:not(.icon-only) svg {
    margin-right: 0.2rem;
  }
  [astro-icon="octicon:search-24"] {
    color: var(--fg);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function handleKeydown(event) {
      if (event.keyCode === 75 && event.metaKey) {
        // Ctrl+K or Cmd+K
        document.querySelector('.open-search-modal').click()
      }
    }

    document.addEventListener('keydown', handleKeydown)
  })
</script>
