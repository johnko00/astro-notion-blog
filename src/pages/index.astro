---
import { NUMBER_OF_POSTS_PER_PAGE } from '../server-constants.ts'
import {
  getPosts,
  getNumberOfPages,
} from '../lib/notion/client.ts'
import Layout from '../layouts/Layout.astro'
import NoContents from '../components/NoContents.astro'
import PostCard from '../components/PostCard.astro'
import Pagination from '../components/Pagination.astro'
import styles from '../styles/blog.module.css'

const [posts, numberOfPages] = await Promise.all([
  getPosts(NUMBER_OF_POSTS_PER_PAGE),
  getNumberOfPages(),
])
---

<Layout>
  <div slot="main" class={styles.home}>
    <section class={styles['home-section']} aria-label="Blog posts">
      {
        posts.length === 0 ? (
          <NoContents contents={posts} />
        ) : (
          <div
            class:list={[
              styles['post-grid'],
              { [styles['post-grid-single']]: posts.length === 1 },
            ]}
          >
            {posts.map((post) => <PostCard post={post} variant="card" />)}
          </div>
        )
      }

      {numberOfPages > 1 && (
        <footer>
          <Pagination currentPage={1} numberOfPages={numberOfPages} />
        </footer>
      )}
    </section>
  </div>
</Layout>
